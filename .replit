language = "nodejs"
run = "npx expo start --web --port 5000 --host 0.0.0.0"
modules = ["nodejs-20"]

[deployment]
run = ["sh", "-c", "npm install --production && node server.js"]
build = ["sh", "-c", "npm ci && npx expo export --platform web"]
deploymentTarget = "cloudrun"
ignoredPaths = [".git", ".expo", ".expo-shared"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --web --port 5000 --host 0.0.0.0"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Web"

[[workflows.workflow]]
name = "Expo Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --web --port 5000 --host 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
