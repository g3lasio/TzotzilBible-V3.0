language = "nodejs"
run = "node server.js"
modules = ["nodejs-20"]
entrypoint = "server.js"

[deployment]
run = ["sh", "-c", "node server.js"]
build = ["sh", "-c", "npm install && npx expo export --platform web"]
deploymentTarget = "cloudrun"
ignoredPaths = [".git", ".expo", ".expo-shared", "text", "attached_assets", "ios", "android"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-24_05"
